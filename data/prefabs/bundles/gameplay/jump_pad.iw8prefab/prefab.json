{
  "format": "iw8r-prefab-1",
  "id": "jump_pad",
  "title": "Jump pad with effect and sound",
  "description": "A pad that throws a player into the air. One object holds the model, the behaviour, the effect and the sound.",
  "category": "gameplay",
  "tags": ["jump", "launch", "gameplay", "effect", "sound"],
  "author": "IW8 Radiant",
  "version": 1,
  "pivot": "centre of the pad, floor level",
  "bounds": {"mins": [-32, -32, 0], "maxs": [32, 32, 24]},
  "placement": {"surface": "floor", "yaw_step": 90},
  "names": {
    "local": ["jump_pad_trigger"]
  },
  "parameters": [
    {
      "name": "speed",
      "label": "Launch speed (units per second, upward)",
      "type": "number",
      "default": 700,
      "min": 100,
      "max": 3000,
      "apply": {"selector": "jump_pad_trigger", "key": "iw8r_jump", "template": "0 0 {speed}"}
    }
  ],
  "requires": {
    "stock_models": [
      {"name": "tm/me_manhole_cover_02", "zones": ["mp_emporium", "mp_hideout"]}
    ],
    "stock_sounds": ["emt_light_fluorescent_hum1_int"],
    "stock_effects": ["vfx/core/mp/core/vfx_marker_base_cyan_pulse"]
  }
}
